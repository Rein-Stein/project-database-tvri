DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tvri_kaltim
# Gunakan REQUIRED untuk koneksi Aiven MySQL production.
DB_SSL=DISABLED

# --- Autentikasi Admin ---
# Jalankan: node scripts/hash-password.js "password-kamu"
# lalu tempel hasilnya ke ADMIN_PASSWORD_HASH di bawah ini.
ADMIN_EMAIL=admin@tvri.co.id
ADMIN_NAME=Administrator TVRI
ADMIN_PASSWORD_HASH=
# Nilai acak panjang untuk menandatangani sesi login. Bisa generate dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Akses manajemen akun ---
# Kredensial akun inti hanya dipakai untuk login kedua di /admin/users/login.
ACCOUNT_MANAGEMENT_EMAIL=admindataklik@gmail.com
ACCOUNT_MANAGEMENT_PASSWORD_HASH=

# Nomor WhatsApp administrator dalam format internasional tanpa tanda + atau spasi.
NEXT_PUBLIC_ADMIN_WHATSAPP=
